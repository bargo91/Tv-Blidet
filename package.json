{
  "name": "blidaoui-tv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check": "node --check app.js",
    "serve": "npx serve .",
    "prepare:web": "node prepare-web.mjs",
    "cap:sync": "npm run prepare:web && npx cap sync",
    "cap:add:android": "npx cap add android",
    "build:apk": "npm run cap:sync && cd android && gradle assembleDebug",
    "cap:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "serve": "^14.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "hls.js": "^1.5.17"
  }
}
